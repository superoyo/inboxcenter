{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // composite = ให้ apps/* อ้างอิงแพ็กเกจนี้ผ่าน project references ได้
    // เป็น type ล้วน ไม่มีโค้ดรันไทม์ จึง emit แค่ .d.ts
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    // เก็บ tsbuildinfo ใน dist เพื่อให้ `rm -rf dist` เป็นการ clean ที่สมบูรณ์
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/**/*.ts"]
}
