# ---------- Server ----------
PORT=3000
NODE_ENV=development
# URL สาธารณะของเซิร์ฟเวอร์ (ใช้สร้าง webhook URL ให้ LINE) — ไม่ตั้งก็เดาจาก request
# PUBLIC_BASE_URL=https://inboxcenter.datafirst.id

# ---------- Storage ----------
# มี DATABASE_URL → ใช้ Postgres, ไม่มี → เก็บไฟล์ JSON ใน data/
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATA_DIR=./data

# ---------- Auth (Wazzup) ----------
WAZZUP_BASE_URL=https://api.fareastfamelineddb.com

# ---------- Facebook Graph API ----------
# ตั้งคู่นี้เพื่อให้ระบบแลก Page token เป็น long-lived อัตโนมัติ (token จะไม่หมดอายุ)
# FB_APP_ID=
# FB_APP_SECRET=

# ---------- Agency Intelligence (feed Product Group + คู่แข่ง) ----------
# หน้า Content อ่าน "เพจที่ปักหมุด + คู่แข่ง" ของแต่ละ Product Group จากที่นี่
# ไม่ตั้งคู่นี้ → หน้า Content ถอยไปใช้เพจที่เชื่อมไว้ + คู่แข่งที่กรอกในเมนู Admin
# AGENCY_BASE_URL=https://agencyintelligence.fareastfameline.com
# ต้องตรงกับ REPORT_SERVICE_KEY ฝั่ง Agency Intelligence (คีย์อยู่ฝั่ง server เท่านั้น)
# REPORT_SERVICE_KEY=

# ---------- Apify (ดึงโพสต์เพจคู่แข่ง) ----------
# เอา token จาก apify.com → Settings → Integrations
# APIFY_TOKEN=
# actor ที่ใช้ (default: apify~facebook-posts-scraper)
# APIFY_FB_ACTOR=apify~facebook-posts-scraper
# ชี้ API ไปที่อื่นได้ (ใช้ตอนทดสอบด้วย mock server)
# APIFY_API_BASE=

# ---------- Log ----------
LOG_LEVEL=info
